<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="skyGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#B0D4E3;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#E0F6FF;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Sky background -->
  <rect width="1920" height="1080" fill="url(#skyGradient)" />
  
  <!-- Clouds -->
  <ellipse cx="300" cy="200" rx="100" ry="40" fill="white" opacity="0.7" />
  <ellipse cx="350" cy="210" rx="80" ry="35" fill="white" opacity="0.6" />
  <ellipse cx="250" cy="210" rx="70" ry="30" fill="white" opacity="0.65" />
  
  <ellipse cx="800" cy="150" rx="120" ry="45" fill="white" opacity="0.65" />
  <ellipse cx="860" cy="160" rx="90" ry="40" fill="white" opacity="0.6" />
  <ellipse cx="750" cy="165" rx="80" ry="35" fill="white" opacity="0.7" />
  
  <ellipse cx="1400" cy="250" rx="110" ry="42" fill="white" opacity="0.6" />
  <ellipse cx="1460" cy="260" rx="95" ry="38" fill="white" opacity="0.65" />
  <ellipse cx="1350" cy="265" rx="75" ry="32" fill="white" opacity="0.7" />
  
  <ellipse cx="600" cy="400" rx="130" ry="50" fill="white" opacity="0.5" />
  <ellipse cx="670" cy="410" rx="100" ry="42" fill="white" opacity="0.55" />
  
  <ellipse cx="1200" cy="500" rx="140" ry="52" fill="white" opacity="0.5" />
  <ellipse cx="1280" cy="510" rx="105" ry="45" fill="white" opacity="0.55" />
</svg>
